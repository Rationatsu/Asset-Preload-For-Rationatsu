{
  "manifest_version": 3,
  "name": "Rationatsu Cursor",
  "version": "1.1.0",
  "description": "Kursor maskot animasi Rationatsu untuk semua tab browser, dengan pengaturan ukuran dan sensitivitas.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pengaturan kursor Rationatsu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["cursors/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
